# ---- Core ----
NODE_ENV=development
PORT=10000
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ---- Database ----
# Leave empty for local development (uses node:sqlite WAL in ./data/bugshield.db).
# In production (Render) set this to the Supabase pooled connection string (port 6543).
DATABASE_URL=
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# ---- AI provider (OpenAI-compatible) ----
# Groq free tier example:
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_MS=45000

# ---- GitHub integration ----
# Fine-grained PAT with Contents:read/write on the client repos.
GITHUB_TOKEN=
GITHUB_API=https://api.github.com

# ---- Seed (local demo only) ----
BUGSHIELD_SEED_EMAIL=admin@bugshield.local
BUGSHIELD_SEED_PASSWORD=BugShieldDemo2024!
BUGSHIELD_SEED_NAME=Bug Shield Admin

# ---- Whats new / version ----
RENDER_GIT_COMMIT=local
