{
  "name": "bugshield",
  "version": "1.0.0",
  "private": true,
  "description": "BugShield - Multi-Agent Driven Intelligent Bug Detection and Secure Deployment System",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "eval": "node benchmark/runner.mjs",
    "demo": "node scripts/serve-demo.mjs",
    "migrate": "node -e \"import('./src/db/migrations.js').then(m=>m.runMigrations())\""
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {}
}
